{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",

    "moduleResolution": "node",
    "esModuleInterop": true,

    "types": ["node", "express"],
    "skipLibCheck": true,

    "strict": false
  },
  "include": ["src"]
}
